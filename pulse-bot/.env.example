# Pulse Bot — environment template. Copy to .env and fill in real values.

# Dashboard URL (used in notification links).
APP_URL=http://localhost:3000

# Discord application credentials (Developer Portal → your app).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Supabase project (same project the dashboard uses).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret for dashboard ↔ bot internal calls.
PULSIFY_BOT_SECRET=

# Twitch app credentials — required ONLY for the Twitch go-live integration
# (PULSIFY-34). Create an app at https://dev.twitch.tv/console/apps. Without
# these, Twitch connections report "Twitch isn't configured on the bot"; every
# other integration works without them.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
